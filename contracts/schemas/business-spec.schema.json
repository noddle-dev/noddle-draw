{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "business-spec",
  "type": "object",
  "required": [
    "meta",
    "actors",
    "flows",
    "acceptance_criteria",
    "out_of_scope"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version",
        "updated",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "purpose": {
          "type": "string"
        },
        "related_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "can"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "who": {
            "type": "string"
          },
          "who_env": {
            "type": "string"
          },
          "can": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object"
    },
    "state_machine": {
      "type": "object",
      "required": [
        "initial",
        "transitions"
      ],
      "properties": {
        "initial": {
          "type": "string"
        },
        "terminal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action",
              "role",
              "from",
              "to"
            ],
            "properties": {
              "action": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "role_constraint": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "sets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "flows": {
      "type": "object"
    },
    "sla": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "http",
          "when",
          "message"
        ],
        "properties": {
          "http": {
            "type": "integer"
          },
          "when": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fe_behaviour": {
            "type": "string"
          }
        }
      }
    },
    "validation_rules": {
      "type": "array"
    },
    "idempotency": {
      "type": "array"
    },
    "copy": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[A-Z0-9]+-\\d+$"
          },
          "text": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
